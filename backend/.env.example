# 로컬 개발용 환경변수 예시.
#
#   cp backend/.env.example backend/.env
#
# `.env` 는 git 에서 제외된다(.gitignore). 실제 시크릿은 이 예시 파일에 쓰지 않는다.
#
# 값은 backend/compose.yml 과 짝이다. 컨테이너 자격증명을 바꾸면 여기도 바꾼다.
#
# --- 불러오는 법 -------------------------------------------------------------
#
#   IntelliJ   Run Configuration → Environment variables → 우측 아이콘에서 .env 선택
#              (또는 EnvFile 플러그인)
#   bash       set -a; . ./.env; set +a; ./gradlew bootRun
#
# ⚠ 이 파일이 compose.yml 과 같은 디렉터리에 있어 `docker compose` 도 .env 를 읽는다.
#   지금 compose.yml 에는 ${...} 치환이 없어 무해하지만, 나중에 치환을 넣는다면
#   여기 값이 컨테이너 설정으로 새어 들어갈 수 있다는 점을 기억한다.
#
# ⚠ 테스트(`./gradlew test`)에는 이 파일이 필요 없다. build.gradle 의
#   tasks.named('test') 가 환경변수를 직접 주입하고 DB·Redis 는 Testcontainers 가 띄운다.
#
# 운영 application.yml 은 시크릿에 기본값을 두지 않는다(미주입 시 부팅 실패).
# 아래 값이 하나라도 비면 앱이 뜨지 않는 것이 의도된 동작이다.
# =============================================================================


# --- DB (backend/compose.yml 의 postgres) ------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jango
DB_USER=jango
DB_PASSWORD=jango

# --- Redis (backend/compose.yml 의 redis) ------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=jango


# --- 보안 --------------------------------------------------------------------
# HMAC-SHA256 서명용. 최소 32바이트여야 하며 짧으면 부팅 시 예외가 난다.
# 로컬 전용 더미다. 운영 값은 서버 시크릿에만 둔다.
JWT_SECRET=local-only-jwt-secret-not-for-production-0123456789abcdef

# 사업자등록번호·계좌번호 원문 암호화 키(FieldEncryptor).
# ⚠ 이 값을 바꾸면 기존에 암호화해 저장한 행을 더 이상 복호화할 수 없다.
#   로컬 DB 를 초기화(`down -v`)하지 않는 한 고정해서 쓴다.
APP_ENCRYPTION_KEY=local-only-encryption-key-0123456789abcdef

# 기본값이 있어 생략 가능하다. 필요할 때만 조정한다.
# JWT_ACCESS_TTL=PT30M
# JWT_REFRESH_TTL=P14D


# --- 파일 저장 ----------------------------------------------------------------
# 기본값 /data/uploads 는 컨테이너 내부 경로라 로컬에서는 쓸 수 없다.
# 프로젝트 안으로 돌려두면 정리가 쉽다(build/ 는 git 제외 대상이다).
#
# ⚠ 이 경로가 기준이다. AI 워커(ai/.env 의 STORAGE_ROOT)가 같은 폴더를 가리켜야 한다 —
#   워커는 업로드된 파일을 이 키로 직접 읽는다. 어긋나면 워커가 파일을 못 찾아
#   모든 추출이 400 이고, 그 400 은 < 500 이라 재시도로 낫지 않는다.
#   워커 쪽은 ai/ 기준 상대경로라 `../backend/build/uploads` 가 같은 곳을 가리킨다.
#
# ⚠ `./gradlew clean` 이 build/ 를 지운다. 업로드한 파일은 사라지는데 DB 의 EVIDENCE 행은
#   남으므로, 그 뒤 재추출은 전부 400 이 된다. 그때는 로컬 DB 도 함께 비우거나
#   (`docker compose -f backend/compose.yml down -v`) 파일을 다시 올린다.
STORAGE_ROOT=./build/uploads


# --- SSAFY 금융망 API ---------------------------------------------------------
# 도메인까지만 적는다. 그 아래 경로가 /member/** 와 /edu/** 로 갈린다.
#   운영 https://finopenapi.ssafy.io   개발 https://ssafy-dev.maum.ai
FINOPENAPI_BASE_URL=https://finopenapi.ssafy.io

# 실제 키는 각자 로컬 `.env` 에 넣는다. 서버 /opt/jango-yebo/secrets/finopenapi.env 에서 가져오거나
# 팀장·백엔드 담당에게 받는다.
#
# 🚫 이 예시 파일(`.env.example`)에는 넣지 않는다 — git 에 커밋되며, 지워도 히스토리에 남는다.
#
# ⚠ 이 키는 사고가 나도 되돌릴 방법이 없다. 사본을 들고 있다는 자각이 필요하다.
#    - 앱 전체가 쓰는 키 하나다. 팀장 이메일로만 발급된다(다른 이메일은 A1080).
#    - `reIssuedApiKey`(MANAGER_02)를 조회 목적으로도 호출하지 않는다.
#      "재발급"이 아니라 "기존 키 즉시 무효화"라 호출하는 순간 팀 전체의 키가 죽고,
#      E3003 때문에 만료 후에는 재발급조차 막힌다.
#    - 로그·이슈·메신저에 붙여넣지 않는다. 금융망 응답이 apiKey 를 되돌려주므로
#      로깅 마스킹은 요청·응답 양방향에 걸어야 한다.
#
# ⚠ 2026-09-08 부터 이 값이 없으면 앱이 뜨지 않는다. 금융망 어댑터가 들어오면서
#    jango.finopenapi.* 를 실제로 바인딩하기 때문이다(AI_SERVICE_TOKEN 과 같은 취급).
#    자리표시자인 채로는 뜨지만 첫 호출에서 실패한다.
FINOPENAPI_API_KEY=__PUT_REAL_KEY_IN_YOUR_LOCAL_ENV__

# 교육용 고정값. 시크릿이 아니다 (docs/기능별_기술스택_선정.md).
FINOPENAPI_INSTITUTION_CODE=00100
FINOPENAPI_FINTECH_APP_NO=001


# --- 예정 거래 자동 반영 (API 9.6) -------------------------------------------
# 확정한 반복 패턴의 예정 거래를 예정일에 금융망 계좌로 실제 출금·입금한다.
# 시연 데이터가 날짜를 넘겨도 스스로 살아 움직이게 하려고 둔 것이다.
#
# ⚠ 계좌 단위 opt-in 이 실제 스위치다 — ACCOUNT.auto_execute_planned 가 켜진 계좌에서만
#   돈다(기본 false, 화면에 없음, 시드 도구가 켠다). 아래 값만 켜져 있으면 아무 일도 없다.
# ⚠ 같은 이메일로 로컬과 서버를 둘 다 시드하면 두 서버가 같은 금융망 계좌를 본다.
#   중복 출금은 금융망 거래내역 사전 조회가 막지만, 굳이 양쪽에서 켤 이유는 없다.
#PLANNED_EXECUTION_ENABLED=true
#PLANNED_EXECUTION_POLL_INTERVAL=PT10M
#PLANNED_EXECUTION_INITIAL_DELAY=PT30S
# 당일자를 보내기 시작하는 시각(KST). 로컬에서 바로 보려면 00:00 으로 내린다.
#PLANNED_EXECUTION_EARLIEST_TIME=09:00
#PLANNED_EXECUTION_CATCH_UP_DAYS=3
#PLANNED_EXECUTION_MAX_ATTEMPTS=3
#PLANNED_EXECUTION_MAX_PER_TICK=20

# --- 내부 AI 워커 (jango-ai) ---------------------------------------------------
# 워커 로컬 포트는 8000 이다 (ai/compose.yml).
AI_SERVICE_BASE_URL=http://localhost:8000

# ⚠ 워커의 SERVICE_TOKEN(ai/.env)과 값이 같아야 한다. 파일이 분리돼 있어 이름은 다르다.
#   워커는 토큰이 비면 "누구나 통과"가 아니라 "아무도 통과 못 함"(401)으로 막는다.
#   로컬 검증용 값은 양쪽에 같은 문자열이면 무엇이든 된다 — 예: openssl rand -base64 32
AI_SERVICE_TOKEN=__LOCAL_DEV_TOKEN__

# --- 지원사업 공고 수집기 (P1-15) ---
# 서버가 읽지 않는다. tools/support-program-collector 가 쓴다.
# 발급: https://www.bizinfo.go.kr/apiDetail.do?id=bizinfoApi 의 「사용신청」 → 이메일 수신
BIZINFO_API_KEY=__기업마당에서_발급받아_붙여넣기__
# 수집기가 적재할 백엔드 주소. 배포 서버에서 돌리면 그 주소로 바꾼다.
COLLECTOR_API_BASE_URL=http://localhost:8080
