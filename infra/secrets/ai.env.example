# 실제 파일: 서버 /opt/jango-yebo/secrets/ai.env (chmod 600, git 제외)
# 서비스 토큰은 서버에서 생성하고 jango-api 쪽 설정에도 같은 값을 넣는다. 이 파일에 실값을 쓰지 않는다.
#   umask 077 && printf 'SERVICE_TOKEN=%s\n' "$(openssl rand -base64 32)" >> /opt/jango-yebo/secrets/ai.env
APP_ENV=prod
BACKEND_BASE_URL=http://jango-api:8080
SERVICE_TOKEN=__CHANGE_ME__
ANTHROPIC_API_KEY=__CHANGE_ME__
AI_PIPELINE_MODE=live
STORAGE_ROOT=/data/uploads

# --- 3번 예측 (명세 20.11 · S15P21C105-76) ---
# off | live. **live 로 켜기 전에 가중치를 서버에 올려야 한다.**
#   mkdir -p /opt/jango-yebo/ai-artifacts
#   scp ai/artifacts/residual-gru.pt deploy@your-server:/opt/jango-yebo/ai-artifacts/
#   chmod 644 /opt/jango-yebo/ai-artifacts/residual-gru.pt      # 컨테이너 uid 10001 이 읽는다
# 파일이 없으면 워커는 뜨지만 예측만 「모델 미상주」로 실패한다 (ai/app/main.py).
FORECAST_MODE=off
# torch 스레드 수. **재현성 때문에 고정한다** — 계약 20.11 이 「동일 입력 + 동일
# modelVersion -> 동일 결과」를 요구하고, 스레드 수가 바뀌면 부동소수 합 순서가 바뀐다.
# compose 에서 cpus: 2.0 으로 묶여 있으니 그 이상으로 올리지 않는다.
FORECAST_THREADS=2
