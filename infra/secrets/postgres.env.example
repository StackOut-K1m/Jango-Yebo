# 실제 파일: 서버 /opt/jango-yebo/secrets/postgres.env (chmod 600, git 제외)
# 비밀번호는 서버에서 직접 생성해 넣는다. 이 파일에 실값을 쓰지 않는다.
#   umask 077 && { echo "POSTGRES_USER=jango"; echo "POSTGRES_DB=jango"; \
#     printf 'POSTGRES_PASSWORD=%s\n' "$(openssl rand -base64 24 | tr -d '/+=' | cut -c1-24)"; \
#   } > /opt/jango-yebo/secrets/postgres.env
POSTGRES_USER=jango
POSTGRES_DB=jango
POSTGRES_PASSWORD=__CHANGE_ME__
