APP_ENV=local
BACKEND_BASE_URL=http://localhost:8080

# 서비스 간 고정 토큰 — jango-api 쪽 설정과 같은 값이어야 한다. 생성: openssl rand -base64 32
SERVICE_TOKEN=__LOCAL_DEV_TOKEN__

# stub: 외부 호출 없이 고정 응답 (백엔드 연동·Job 완결 검증용) / live: 실제 모델 호출
AI_PIPELINE_MODE=stub

# fileObjectKey 기준 경로. **백엔드가 기준이고 워커가 따라간다** — 백엔드가 업로드한 파일을
# 워커가 같은 키로 읽으므로 두 값이 같은 폴더여야 한다.
# 아래는 ai/ 기준 상대경로이고 backend/.env 의 STORAGE_ROOT=./build/uploads 와 같은 곳이다.
# 어긋나면 워커가 파일을 못 찾아 모든 추출이 400 이고, 그 400 은 < 500 이라 재시도로 낫지 않는다.
# ⚠ `./gradlew clean` 이 이 폴더를 지운다. 파일은 사라지고 DB 행은 남아 재추출이 전부 400 이 된다.
STORAGE_ROOT=../backend/build/uploads

# live 모드에서만 필요. 여기 두면 Settings 가 읽어 SDK 에 넘기고, 환경 변수로 주면 SDK 가 직접 읽는다. 코드에 넣지 않는다.
# ANTHROPIC_API_KEY=
# 게이트웨이(SSAFY GMS 등)를 거칠 때 — 원본 호스트까지만 적는다(SDK 가 /v1/messages 를 붙인다).
# 게이트웨이가 Authorization: Bearer 를 요구하면 ANTHROPIC_API_KEY 대신 ANTHROPIC_AUTH_TOKEN 에 키를 넣는다.
# 점검: uv run --frozen python -X utf8 -m scripts.ping_claude
# ANTHROPIC_BASE_URL=https://gms.ssafy.io/gmsapi/api.anthropic.com
# ANTHROPIC_AUTH_TOKEN=
# 게이트웨이가 beta 헤더·fallbacks 를 거부하면 false (§8.6 서버측 폴백만 잃는다)
# CLAUDE_SERVER_FALLBACK=true
# 시스템 프롬프트 캐시(§8.3). 게이트웨이가 cache_control 을 거부하면 false
# CLAUDE_PROMPT_CACHE=true
# GMS 키는 토큰 쿼터가 있다 — 소진되면 401 "This GMS key has no token left" 로 모든 호출이 실패한다.
# 워커는 이를 stage=quota 로 구분하고, 평가기는 첫 실패에서 멈춘다. 점검: uv run --frozen python -X utf8 -m scripts.ping_claude

# VLM 제공자 — claude(Anthropic·GMS) 또는 local(사용자 PC 의 Ollama, 토큰 0, 개발·검증용)
# 로컬은 정확도가 낮아 최종 수치에는 쓰지 않는다. 준비: ollama serve · ollama pull qwen2.5vl:7b
# 점검: uv run --frozen python -X utf8 -m scripts.smoke_vlm 영수증.jpg --local
# VLM_PROVIDER=claude
# LOCAL_VLM_BASE_URL=http://localhost:11434
# LOCAL_VLM_MODEL=qwen2.5vl:7b   # 8GB VRAM 에서 OOM 이면 qwen2.5vl:3b
# LOCAL_VLM_TIMEOUT_SECONDS=180

# ---- 실 서비스 비용 절감 프리셋 (각 항목은 정확도를 20장으로 확인한 뒤 켠다) ----
# 1) 모델 티어링 — 1차는 싼 모델, 검산이 needsReview 를 내는 건만 승격. 실측 needsReview 12%
#    이므로 대부분 1차로 끝난다. Sonnet 기준 약 45%, Haiku 기준 약 75% 절감.
# VISION_MODEL=claude-haiku-4-5-20251001
# VISION_ESCALATION_MODEL=claude-opus-4-8
# 2) 여백 절단 + 장변 축소 — 촬영 이미지에서 글자 크기를 유지한 채 이미지 토큰 18% 절감 (실측).
#    절단만 켜면 화면이 정사각형에 가까워져 토큰이 되레 는다. 장변을 함께 낮춰야 한다.
# IMAGE_CROP_MARGINS=true
# IMAGE_LONG_EDGE=1400
# 3) 사고·출력 토큰 — 출력 단가가 입력의 5배다. 프롬프트 v4 가 warnings 를 3개·60자로 묶는다.
# EVIDENCE_EFFORT=medium

# 모델 라우트 (기술스택 §5.1, §8.5 — effort 는 라우트별로 튠한다)
# VISION_MODEL=claude-opus-5
# EVIDENCE_EFFORT=high
# EVIDENCE_MAX_TOKENS=8192   # 출력 + thinking 상한. 4096 에서는 열화 이미지 50장 중 2장이 잘렸다
# PRODUCT_SALES_EFFORT=high
# IMAGE_LONG_EDGE=1600
# 긴 영수증을 세로 타일로 나눠 여러 장으로 보낸다 (글자 해상도 ↑, 이미지 토큰 ↑). 실험으로 효과를 확인한 뒤 켠다
# EVIDENCE_TILING=false
# EVIDENCE_TILE_MAX_ASPECT=1.5
# 1번 거래 분류 (20.3).
# ⚠ **기본값은 claude-haiku-4-5 다.** 개발 중 크레딧을 아끼려고 내린 값이고 시연·발표에
#   쓸 모델이 아니다. 시연에는 아래 줄의 주석을 풀어 Sonnet 으로 돌린다.
# CLASSIFICATION_MODEL=claude-sonnet-5
#
# 근거 — 라벨 300건을 3회씩 채점해 Sonnet 은 Macro F1 0.9226 · 수락률 0.9927 이 나왔고,
# Haiku 4.5 는 0.8661 로 평균은 기준 0.85 를 넘지만 **최저 회차가 0.8512** 라 여유가
# +0.0012 다(표준편차의 1/10). 다시 돌리면 게이트가 빨개질 수 있다.
# 조용한 오답도 회차당 9~10건 대 Sonnet 1건이다 — 신뢰도 0.85 이상은 사용자 확인 없이
# 확정되고(8.2) 그 매핑이 거래처 사전에 캐시되므로(도메인 규칙 3) 틀린 판단이 굳는다.
# ⚠ evals/p1-01/report.json 은 **Sonnet 기준**이다. 기본값으로 돌린 점수가 아니다.
# Opus 5 는 이 경로에서 쓰지 않는다.
# 서버측 폴백은 Opus 5 전용이지만 claude.py 가 첫 400 에서 배워 빼므로 함께 끌 필요는 없다.
# CLASSIFICATION_EFFORT=medium            # 짧은 텍스트 20건 판단 — 증빙 추출보다 낮게
# CLASSIFICATION_MAX_TOKENS=4096          # BATCH_MAX 를 올리면 이 값도 함께 올린다

# 1번 브리핑 (20.7). 티켓은 Opus 5 를 적었지만 쓰지 않는다 — 이 경로는 계산을 시키지 않고
# 주어진 숫자를 문장으로 옮기기만 해서 분류보다 추론 난도가 낮다. 분류가 Sonnet 으로
# Macro F1 0.9226 을 낸 마당에 그 위 모델을 쓸 근거가 없다.
# BRIEFING_MODEL=claude-sonnet-5
# BRIEFING_EFFORT=low                     # 문장 몇 개를 쓰는 일이라 분류(medium)보다 낮다
# BRIEFING_MAX_TOKENS=2048

# 1번 초안 점검 (20.10). 브리핑과 같은 모델이다 — 이 경로도 계산을 시키지 않고, 주어진
# 합계·건수를 읽어 "무엇을 확인해야 하는가" 를 문장으로 옮긴다.
# ASSIST_MODEL=claude-sonnet-5
# effort 는 브리핑(low)보다 높다. 브리핑은 지표를 문장으로 옮기면 끝이지만 여기는 항목
# 사이 관계를 봐야 한다 — 증빙 누락 3건이 왜 문제인지, 보류 항목이 어느 서식 칸에 걸리는지.
# ASSIST_EFFORT=high
# ASSIST_MAX_TOKENS=2048                  # 점검 문장 몇 개라 출력은 작고 나머지는 thinking 여유
# ⚠ 명세 20.10 이 정한 동기 타임아웃이고 **워커가 스스로도 지킨다.** 백엔드가 먼저 끊어도
# 워커는 모델 호출을 계속해 받을 사람 없는 응답에 토큰을 태우기 때문이다. 20.10 은 넷 중
# 유일한 동기 경로라 jobId·콜백이 없다 — 실패해도 200 에 빈 목록이다.
# ASSIST_TIMEOUT_SECONDS=10.0
# COMPUTE_CONCURRENCY=1   # 자체 호스팅 모델 동시 실행 상한 (명세 20.1 ④)

# ---- 품목 정규화 3차 LLM (20.5, §6.5) ----
# 2차 유사도 0.70~0.92 인 건만 묶어 한 번 부른다. 후보가 없으면 호출하지 않는다.
# 기본 모델이 opus-5 인데 짧은 텍스트 판정에 4배 비싸다(5/25 vs 2/10). 실측은 sonnet 으로 했다
# — 45회 호출 $0.11, 평균 3.1초, 후보 밖 itemId·스키마 오류 0건.
# NORMALIZATION_MODEL=claude-opus-5
# NORMALIZATION_EFFORT=low
# NORMALIZATION_MAX_TOKENS=2048          # 50건 묶음에 1,536 + thinking 여유
# NORMALIZATION_TIMEOUT_SECONDS=8.0      # 동기 응답(10초) 안에 끝나야 한다. 넘으면 미매칭 폴백
# NORMALIZATION_ACCEPT_CONFIDENCE=0.8    # 이 아래면 LLM 이 같다고 해도 버린다 (오매칭 > 미매칭)

# 매출 인쇄물 출력 상한 — 8192 에서 행이 많은 표본 1장이 잘렸다
# PRODUCT_SALES_MAX_TOKENS=16384

# ---- 콜백 (명세 20.2) ----
# 5xx 는 재시도, 4xx 는 즉시 포기. 실패로 끝난 Job 은 API 서버의 JobSweeper 가 회수한다.
# CALLBACK_TIMEOUT_SECONDS=5.0
# CALLBACK_MAX_RETRIES=3
# CALLBACK_BACKOFF_SECONDS=0.5

# ---- Circuit Breaker: 워커 → Anthropic (기술스택 §8.6·§8.7 규칙 6) ----
# 재시도 가능한 실패(429·5xx·네트워크)가 연속 5회면 60초 동안 그 기능만 끈다.
# 400·404·401 은 세지 않는다 — 60초 뒤에 저절로 낫는 종류가 아니다.
# 백엔드 → 워커 구간의 차단기는 백엔드(resilience4j)가 따로 둔다. 별개다.
# 운영값을 바꾸지 마라. 테스트가 60초를 안 기다리려고 설정으로 뺀 것뿐이다.
# CIRCUIT_FAILURE_THRESHOLD=5
# CIRCUIT_OPEN_SECONDS=60.0

# 3번 예측 (20.11) — off 가 기본. live 로 켜면 artifacts/residual-gru.pt 가 있어야 한다
# FORECAST_MODE=off
# FORECAST_THREADS=2

# OCR_PIPELINE 공급자 — 선정(기술스택 §12) 후 한쪽만 채운다
# CLOVA_OCR_INVOKE_URL=
# CLOVA_OCR_SECRET=
# AZURE_DOCINTEL_ENDPOINT=
# AZURE_DOCINTEL_KEY=
